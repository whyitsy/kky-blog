# ============================================================================
# docker compose 的环境变量模板
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env，把 JWT_SIGNING_KEY 和 POSTGRES_PASSWORD 换成你自己的值
#   docker compose up -d --build
#
# ⚠️ .env **不能被提交**（已在 .gitignore 里用根路径规则 /.env 忽略）。
#    本模板文件（.env.example）不含任何真实密钥，可以安全入库。
# ============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────

# JWT 签名密钥。**至少 32 字节**，否则应用会拒绝启动（Program.cs 的刻意设计：
# 静默使用弱密钥意味着任何人都能伪造 token，后果比启动失败严重得多）。
#
# 生成一个：
#   openssl rand -base64 48
# 或（Windows / WSL 都可）：
#   head -c 48 /dev/urandom | base64
JWT_SIGNING_KEY=

# 数据库密码。生产环境请务必改掉，不要用开发机上那套 kky/123456。
POSTGRES_PASSWORD=

# ── 选填（不填则用下面的默认值）─────────────────────────────────────────

# Nginx 对外端口
HTTP_PORT=8080

POSTGRES_USER=kky
POSTGRES_DB=blog_stage2

# PostgreSQL 镜像。默认是社区维护的「官方 postgres + 中文分词 zhparser」镜像，
# 所以本项目**不再自己构建 PG 镜像**（与 Redis 同类：只拉不建）。
#
# ⚠️ 上游只发布大版本 tag（12~18），没有 patch 级 tag —— 详见 docker-compose.yml 里的说明。
# 一般不用改这一项；留在这里是为了「需要临时锁定/换源」时改一行就够，不用动编排文件。
# POSTGRES_IMAGE=mixdeve/postgres-zhparser:18

JWT_ISSUER=blog-api
JWT_AUDIENCE=blog-frontend
